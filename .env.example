# Runtime defaults. Docker Compose overrides HOST, PORT, NODE_ENV, and the
# private-content path with fixed container-safe values.
HOST=0.0.0.0
PORT=4321
NODE_ENV=production

# Protected routes — placeholders only. Generate both values directly into a
# mode-0600 .env.deployment with scripts/generate-deployment-secrets.mjs.
# Keep this file free of real credentials.
FCFL_PROTECTED_PASSWORD_HASH=
FCFL_SESSION_SECRET=
FCFL_PRIVATE_CONTENT_PATH=/app/private-content/protected-pages.json

# Enable only when the app has exactly one trusted, sanitizing reverse proxy
# and direct access to the application port is blocked.
FCFL_TRUST_PROXY=false
# Set false only for local HTTP QA. Keep true behind production HTTPS.
FCFL_COOKIE_SECURE=true
