---
import StripeEmailGate from "./StripeEmailGate.astro";
import type { StripeIntegration } from "../lib/content";

interface Props {
  contentHtml: string;
  id?: string | null;
  className?: string;
  stripeIntegration?: StripeIntegration | null;
}

const { contentHtml, id = "content", className = "", stripeIntegration = null } = Astro.props;

const TRUSTED_INSTAGRAM_BLOCK_PATTERN =
  /<blockquote\b(?=[^>]*\bclass=(?:"[^"]*\binstagram-media\b[^"]*"|'[^']*\binstagram-media\b[^']*'))(?=[^>]*\bdata-instgrm-permalink=(?:"https:\/\/www\.instagram\.com\/fatcatfablab\/[^"]*"|'https:\/\/www\.instagram\.com\/fatcatfablab\/[^']*'))[^>]*>/i;
const hasTrustedInstagramEmbed = TRUSTED_INSTAGRAM_BLOCK_PATTERN.test(contentHtml);

// Captured component shells need the Squarespace runtime to become interactive.
// Replace only known inert/runtime-dependent markup while preserving captured
// iframes, images, links, and block structure.
const CAPTURED_MAP_BLOCK_PATTERN =
  /<div class="[^"]*\bsqs-block-map\b[^"]*\bmap-block\b"[\s\S]*?<\/div>\s*<\/div>\s*(?=<div class="sqs-block html-block)/gi;
const CAPTURED_LAZY_IMAGE_PATTERN = /<img\b(?=[^>]*\bdata-src=)[^>]*>/gi;
const SOCIAL_SPRITE_SVG_PATTERN =
  /<svg\b[^>]*class="[^"]*\bsqs-svg-icon--social\b[^"]*"[^>]*>[\s\S]*?<\/svg>/gi;
const SCRIPT_TAG_PATTERN = /<script\b[^>]*>[\s\S]*?<\/script\s*>/gi;
const STRIPE_PLACEHOLDER_PATTERN =
  /<div\b[^>]*\bid=(?:["'])?fcfl-email-form(?:["'])?[^>]*><\/div>/gi;

const hydrateCapturedImage = (tag: string) => {
  let hydrated = tag.replace(/\sdata-load=("|')false\1/i, ' data-load="true"');
  hydrated = hydrated.replace(/\sonload=("|')[\s\S]*?\1/i, "");

  if (!/\ssrc=("|')/i.test(hydrated)) {
    const source = hydrated.match(/\sdata-src=("|')([^"']+)\1/i)?.[2];
    if (source) hydrated = hydrated.replace(/<img\b/i, `<img src="${source}"`);
  }

  if (/\sclass=("|')/i.test(hydrated)) {
    hydrated = hydrated.replace(/\sclass=("|')([^"']*)\1/i, (_match, quote, classes) => {
      const nextClasses = new Set(`${classes} loaded`.trim().split(/\s+/));
      return ` class=${quote}${[...nextClasses].join(" ")}${quote}`;
    });
  } else {
    hydrated = hydrated.replace(/<img\b/i, '<img class="loaded"');
  }

  return hydrated;
};

const inlineSocialIconFor = (platform: string) => {
  if (platform === "instagram") {
    return '<svg data-inline-social-icon="instagram" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.25" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.7" r="1.15" fill="currentColor"/></svg>';
  }
  if (platform === "facebook") {
    return '<svg data-inline-social-icon="facebook" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.2 8.2V6.4c0-.8.5-1 1-1h2.6V1.2L14.3 1C10.5 1 9 3.3 9 6v2.2H6v4.7h3V23h5.2V12.9h3.4l.6-4.7h-4z"/></svg>';
  }
  if (platform === "twitter") {
    return '<svg data-inline-social-icon="twitter" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23.95 4.57a9.83 9.83 0 0 1-2.83.78 4.93 4.93 0 0 0 2.16-2.72 9.86 9.86 0 0 1-3.13 1.2A4.92 4.92 0 0 0 11.63 7.2c0 .39.04.77.13 1.12A13.98 13.98 0 0 1 1.61 3.17a4.92 4.92 0 0 0 1.52 6.57 4.9 4.9 0 0 1-2.23-.62v.06a4.93 4.93 0 0 0 3.95 4.83 4.93 4.93 0 0 1-2.22.08 4.93 4.93 0 0 0 4.6 3.42A9.88 9.88 0 0 1 1.12 19.6c-.4 0-.79-.02-1.17-.07a13.93 13.93 0 0 0 7.55 2.21c9.06 0 14.01-7.5 14.01-14.01l-.02-.64a10.01 10.01 0 0 0 2.46-2.55Z"/></svg>';
  }
  return "";
};

const replaceCapturedSocialSprite = (svg: string) => {
  const platform = svg.match(/social-accounts\.svg#(instagram|facebook|twitter)-/i)?.[1]?.toLowerCase();
  return platform ? inlineSocialIconFor(platform) : "";
};

const locationMapHtml = `
  <div class="sqs-block sqs-block-map map-block fcfl-location-map" data-aspect-ratio="41.69329073482428">
    <div class="sqs-block-content">
      <iframe
        src="https://www.google.com/maps?q=40.7338569,-74.003074&amp;z=15&amp;output=embed"
        title="Map showing Fat Cat Fab Lab at 224 West 4th Street, New York, NY 10014"
        loading="eager"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <noscript><a href="https://www.google.com/maps/search/?api=1&amp;query=40.7338569,-74.003074">Open Fat Cat Fab Lab at 224 West 4th Street in Google Maps</a></noscript>
    </div>
  </div>`;

const stripePlaceholders = [...contentHtml.matchAll(STRIPE_PLACEHOLDER_PATTERN)];
const stripeDescriptor =
  stripeIntegration && stripePlaceholders.length === 1
    ? {
        capturedId: stripeIntegration.id,
        mode: stripeIntegration.kind,
      }
    : null;

const safeContentHtml = contentHtml
  .replace(CAPTURED_MAP_BLOCK_PATTERN, locationMapHtml)
  .replace(SCRIPT_TAG_PATTERN, "")
  .replace(CAPTURED_LAZY_IMAGE_PATTERN, hydrateCapturedImage)
  .replace(SOCIAL_SPRITE_SVG_PATTERN, replaceCapturedSocialSprite);
STRIPE_PLACEHOLDER_PATTERN.lastIndex = 0;
const safePlaceholder = stripeDescriptor ? STRIPE_PLACEHOLDER_PATTERN.exec(safeContentHtml) : null;
const beforeStripeGate = safePlaceholder ? safeContentHtml.slice(0, safePlaceholder.index) : safeContentHtml;
const afterStripeGate = safePlaceholder
  ? safeContentHtml.slice(safePlaceholder.index + safePlaceholder[0].length)
  : "";
---

<div
  id={id}
  class:list={["main-content", className]}
  data-content-field="main-content"
>
  {
    stripeDescriptor && safePlaceholder ? (
      <>
        <Fragment set:html={beforeStripeGate} />
        <StripeEmailGate capturedId={stripeDescriptor.capturedId} mode={stripeDescriptor.mode} />
        <Fragment set:html={afterStripeGate} />
      </>
    ) : (
      <Fragment set:html={safeContentHtml} />
    )
  }
</div>
{
  hasTrustedInstagramEmbed && (
    <script
      is:inline
      async
      src="https://www.instagram.com/embed.js"
      data-fcfl-instagram-embed
    ></script>
  )
}
