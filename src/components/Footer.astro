---
import navigation from "../data/navigation.json";
import site from "../data/site.json";
import SocialLinks from "./SocialLinks.astro";

const organizationName = site.fullTitle.split(" - ")[0];
---

<footer id="footer" role="contentinfo">
  <div class="footer-inner">
    <div class="nav-wrapper back-to-top-nav">
      <nav aria-label="Back to top">
        <div class="back-to-top">
          <a href="#header">Back to Top</a>
        </div>
      </nav>
    </div>

    <div
      id="secondaryNavWrapper"
      class="nav-wrapper"
      data-content-field="navigation-secondaryNav"
    >
      <nav
        class="footer-navigation"
        id="secondaryNavigation"
        aria-label="Footer navigation"
        data-content-field="navigation-secondaryNav"
      >
        {
          navigation.footer.map((item) => (
            <div class="collection">
              <a href={item.href}><span>{item.label}</span></a>
            </div>
          ))
        }
      </nav>
    </div>

    <div id="siteInfo">
      <span class="site-address">
        {organizationName}, {site.address.line1}, {site.address.line2}
      </span>
      <a href={`mailto:${site.email}`} class="site-email">
        <span>{site.email}</span>
      </a>
    </div>

    <SocialLinks socialLinks={site.socialUrls} />
  </div>
</footer>
