---
import type { ImageData, VideoData } from "../lib/content";

interface Props {
  image?: ImageData | null;
  video?: VideoData | null;
  descriptionHtml?: string;
  allowBackgroundVideo?: boolean;
  thumbnailId?: string;
  label?: string;
}

const {
  image = null,
  video = null,
  descriptionHtml = "",
  allowBackgroundVideo = false,
  thumbnailId = "thumbnail",
  label = "",
} = Astro.props;

const fallbackImage = image ?? video?.fallbackImage ?? null;
const focalX = fallbackImage?.focalPoint?.x ?? 0.5;
const focalY = fallbackImage?.focalPoint?.y ?? 0.5;
const objectPosition = `${focalX * 100}% ${focalY * 100}%`;
const altText = (fallbackImage?.altHtml ?? "")
  .replace(/<[^>]*>/g, " ")
  .replace(/&nbsp;|&#160;/g, " ")
  .replace(/&amp;/g, "&")
  .replace(/\s+/g, " ")
  .trim() || fallbackImage?.title || fallbackImage?.filename || "";

function youtubeId(rawUrl: string | null | undefined): string | null {
  if (!rawUrl?.trim()) return null;
  try {
    const url = new URL(rawUrl);
    if (url.hostname === "youtu.be") return url.pathname.split("/").filter(Boolean)[0] ?? null;
    if (url.hostname === "youtube.com" || url.hostname.endsWith(".youtube.com")) {
      if (url.pathname === "/watch") return url.searchParams.get("v");
      const [, kind, id] = url.pathname.split("/");
      if ((kind === "embed" || kind === "shorts") && id) return id;
    }
  } catch {
    return null;
  }
  return null;
}

function vimeoId(rawUrl: string | null | undefined): string | null {
  if (!rawUrl?.trim()) return null;
  try {
    const url = new URL(rawUrl);
    if (url.hostname === "vimeo.com" || url.hostname.endsWith(".vimeo.com")) {
      return url.pathname.split("/").find((part) => /^\d+$/.test(part)) ?? null;
    }
  } catch {
    return null;
  }
  return null;
}

const capturedVideoUrl = allowBackgroundVideo ? video?.url : null;
const videoId = youtubeId(capturedVideoUrl);
const capturedVimeoId = vimeoId(capturedVideoUrl);
const localVideoSrc = videoId === "hw-HQtzMvJQ" ? "/media/fcfl-home-hero.mp4" : null;
const embedVideoSrc = capturedVimeoId
  ? `https://player.vimeo.com/video/${capturedVimeoId}?background=1&autoplay=1&muted=1&loop=1&title=0&byline=0&portrait=0`
  : videoId && !localVideoSrc
    ? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&disablekb=1&fs=0&iv_load_policy=3&loop=1&playlist=${videoId}&playsinline=1&rel=0&modestbranding=1`
    : null;
const hasVideo = Boolean(localVideoSrc || embedVideoSrc);
const hasDescription = Boolean(descriptionHtml.trim());
---

<div
  class:list={["banner-thumbnail-wrapper", { "has-description": hasDescription }]}
  data-content-field="main-image"
>
  <div class="color-overlay"></div>
  <figure id={thumbnailId} class="thumbnail loading content-fill">
    {fallbackImage?.src && !hasVideo && (
      <img
        src={fallbackImage.src}
        alt={altText}
        data-image={fallbackImage.src}
        data-image-dimensions={fallbackImage.originalSize ?? undefined}
        data-image-focal-point={`${focalX},${focalY}`}
        style={`object-position: ${objectPosition};`}
      />
    )}
    {localVideoSrc && (
      <>
        {fallbackImage?.src && (
          <img
            class="background-video-poster"
            src={fallbackImage.src}
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="high"
            data-hero-video-poster
            style={`object-position: ${objectPosition};`}
            aria-hidden="true"
          />
        )}
        <video
          class="background-video background-video-local"
          muted
          loop
          playsinline
          preload="auto"
          poster={fallbackImage?.src}
          tabindex="-1"
          data-hero-video
          aria-hidden="true"
        >
          <source src={localVideoSrc} type="video/mp4" />
        </video>
      </>
    )}
    {embedVideoSrc && (
      <iframe
        class="background-video background-video-embed"
        src={embedVideoSrc}
        title={`${label || altText || "Page"} background video`}
        loading="eager"
        tabindex="-1"
        frameborder="0"
        allow="autoplay; encrypted-media; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        aria-hidden="true"
      ></iframe>
    )}
  </figure>
  {hasDescription && (
    <div class="desc-wrapper" data-content-field="description" set:html={descriptionHtml}></div>
  )}
</div>
{localVideoSrc && <script src="/scripts/hero-video.js" is:inline defer></script>}
