---
interface Props {
  socialLinks: string[];
}

const { socialLinks } = Astro.props;
const platformFor = (url: string) => {
  if (url.includes("instagram.com")) return { key: "instagram", label: "Instagram" };
  if (url.includes("facebook.com")) return { key: "facebook", label: "Facebook" };
  return { key: "twitter", label: "Twitter" };
};
---

<nav class="social-links" aria-label="Social media">
  {
    socialLinks.map((url) => {
      const platform = platformFor(url);
      return (
        <a
          class="social-link"
          data-platform={platform.key}
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${platform.label} (opens in a new tab)`}
        >
          {platform.key === "instagram" && (
            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4.25"></circle>
              <circle class="icon-fill" cx="17.4" cy="6.7" r="1.15"></circle>
            </svg>
          )}
          {platform.key === "facebook" && (
            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
              <path class="icon-fill" d="M14.2 8.2V6.4c0-.8.5-1 1-1h2.6V1.2L14.3 1C10.5 1 9 3.3 9 6v2.2H6v4.7h3V23h5.2V12.9h3.4l.6-4.7h-4z"></path>
            </svg>
          )}
          {platform.key === "twitter" && (
            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
              <path class="icon-fill" d="M23.95 4.57a9.83 9.83 0 0 1-2.83.78 4.93 4.93 0 0 0 2.16-2.72 9.86 9.86 0 0 1-3.13 1.2A4.92 4.92 0 0 0 11.63 7.2c0 .39.04.77.13 1.12A13.98 13.98 0 0 1 1.61 3.17a4.92 4.92 0 0 0 1.52 6.57 4.9 4.9 0 0 1-2.23-.62v.06a4.93 4.93 0 0 0 3.95 4.83 4.93 4.93 0 0 1-2.22.08 4.93 4.93 0 0 0 4.6 3.42A9.88 9.88 0 0 1 1.12 19.6c-.4 0-.79-.02-1.17-.07a13.93 13.93 0 0 0 7.55 2.21c9.06 0 14.01-7.5 14.01-14.01l-.02-.64a10.01 10.01 0 0 0 2.46-2.55Z"></path>
            </svg>
          )}
          <span class="visually-hidden">{platform.label}</span>
        </a>
      );
    })
  }
</nav>
