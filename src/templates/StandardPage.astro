---
import BaseLayout from "../layouts/BaseLayout.astro";
import FolderNavigation from "../components/FolderNavigation.astro";
import PageBanner from "../components/PageBanner.astro";
import SquarespaceContent from "../components/SquarespaceContent.astro";
import { getHomeIndexSections, type PublicPage } from "../lib/content";
import "../styles/pages.css";

interface Props {
  page: PublicPage;
}

const { page } = Astro.props;
const sectionSlugs = new Set(getHomeIndexSections().map(({ slug }) => slug));
const hasFolderNavigation = sectionSlugs.has(page.slug);
const hasBanner = Boolean(page.mainImage || page.video?.url?.trim());
const pageClass = hasBanner ? "standard-page has-page-banner" : "standard-page";
const bodyClass = [
  "transparent-header",
  "banner-button-style-outline",
  "banner-button-corner-style-square",
  `collection-type-${page.type}`,
  "collection-layout-default",
  hasFolderNavigation ? "has-folder-navigation" : "",
  hasFolderNavigation ? "hide-sidebar-title" : "",
  "mobile-style-available",
  hasBanner ? "has-banner-image" : "",
  "general-page",
]
  .filter(Boolean)
  .join(" ");
---

<BaseLayout
  title={page.title}
  description={page.seo.description}
  canonical={page.seo.canonical ?? page.path}
  noindex={page.seo.noindex}
  pageClass={pageClass}
  bodyClass={bodyClass}
>
  {hasBanner && (
    <PageBanner
      image={page.mainImage ?? page.video?.fallbackImage}
      video={page.video}
      descriptionHtml={page.descriptionHtml}
      allowBackgroundVideo={Boolean(page.video?.url?.trim())}
      label={page.title}
    />
  )}
  {
    hasFolderNavigation ? (
      <div class="folder-page-shell">
        <FolderNavigation currentSlug={page.slug} />
        <SquarespaceContent contentHtml={page.contentHtml} stripeIntegration={page.stripeIntegration} />
      </div>
    ) : (
      <div class="standard-page-shell">
        <SquarespaceContent contentHtml={page.contentHtml} stripeIntegration={page.stripeIntegration} />
      </div>
    )
  }
</BaseLayout>
