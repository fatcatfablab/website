---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndexSection from "../components/IndexSection.astro";
import type { PublicPage } from "../lib/content";
import "../styles/pages.css";

interface Props {
  page: PublicPage;
}

const { page } = Astro.props;
const heroPoster = page.indexSections[0]?.video?.fallbackImage?.src
  ?? page.indexSections[0]?.mainImage?.src
  ?? null;
const bodyClass = [
  "transparent-header",
  "banner-button-style-outline",
  "banner-button-corner-style-square",
  "collection-type-index",
  "collection-layout-default",
  "homepage",
  "view-list",
  "mobile-style-available",
  "has-banner-image",
  "index-page",
].join(" ");
---

<BaseLayout
  title={page.title}
  description={page.seo.description}
  canonical={page.seo.canonical ?? page.path}
  noindex={page.seo.noindex}
  pageClass="home-page"
  bodyClass={bodyClass}
>
  {heroPoster && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={heroPoster}
      fetchpriority="high"
    />
  )}
  <div id="content" class="main-content" data-content-field="main-content">
    {page.indexSections.map((section) => <IndexSection section={section} />)}
  </div>
</BaseLayout>
