---
const title = "Maker Workshops | Fat Cat Fab Lab";
const description = "Suggest maker workshops and RSVP to the classes you would attend at Fat Cat Fab Lab.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/097091c1b730-favicon.ico" />
    <link rel="stylesheet" href="/styles/maker-workshops.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#workshop-app">Skip to form</a>
    <main id="workshop-app" class="workshop-app" data-api-origin="https://fcfl-maker-workshops-api.pages.dev">
      <header class="workshop-header">
        <a class="brand" href="/maker-workshops" aria-label="Return to workshop results">
          <span class="brand-mark" aria-hidden="true">FC</span>
          <span>Maker Workshops</span>
        </a>
        <div class="step-status" aria-live="polite">
          <span id="step-label">Step 1 of 3</span>
          <span class="step-track" aria-hidden="true"><span id="step-progress"></span></span>
        </div>
      </header>

      <section class="form-stage" aria-label="Maker workshops form">
        <div class="ambient-grid" aria-hidden="true"></div>

        <section class="step is-active" data-step="1" aria-labelledby="intro-title">
          <div class="step-copy">
            <p class="eyebrow"><span>01</span> Start here</p>
            <h1 id="intro-title">What should we make <em>together?</em></h1>
            <p class="lede">Share an idea, then choose the workshops you’d show up for.</p>
          </div>
          <form id="identity-form" class="typeform-fields" novalidate>
            <label class="field">
              <span>First name <b>*</b></span>
              <input id="first-name" name="firstName" type="text" autocomplete="given-name" maxlength="60" placeholder="Type your answer…" required />
            </label>
            <label class="field">
              <span>Email <small>Optional</small></span>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" />
            </label>
            <p id="identity-error" class="form-error" role="alert"></p>
            <button class="primary-button" type="submit">Next <span aria-hidden="true">→</span></button>
          </form>
        </section>

        <section class="step" data-step="2" aria-labelledby="idea-title" hidden>
          <div class="step-copy">
            <p class="eyebrow"><span>02</span> Suggest</p>
            <h1 id="idea-title">Workshop / class idea</h1>
            <p class="lede">One clear line is enough. We’ll add it to the live list.</p>
          </div>
          <form id="idea-form" class="typeform-fields" novalidate>
            <label class="field">
              <span>Your idea</span>
              <input id="workshop-idea" name="idea" type="text" maxlength="120" placeholder="Intro to laser cutting" />
            </label>
            <label class="na-option">
              <input id="no-idea" type="checkbox" />
              <span class="na-box" aria-hidden="true"></span>
              <span>No idea right now</span>
              <kbd>N/A</kbd>
            </label>
            <p id="idea-error" class="form-error" role="alert"></p>
            <div class="form-actions">
              <button class="text-button" type="button" data-back>Back</button>
              <button class="primary-button" type="submit">Next <span aria-hidden="true">→</span></button>
            </div>
          </form>
        </section>

        <section class="step step--list" data-step="3" aria-labelledby="list-title" hidden>
          <div class="list-heading">
            <div>
              <p class="eyebrow"><span>03</span> Show up</p>
              <h1 id="list-title">Which would you attend?</h1>
              <p class="lede">Choose as many as you like. Refresh anytime to see new ideas.</p>
            </div>
            <button id="refresh-button" class="refresh-button" type="button" aria-label="Refresh workshop list">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M6.1 9a7 7 0 0 1 11.5-2L20 9M4 15l2.4 2A7 7 0 0 0 18 15" /></svg>
              Refresh
            </button>
          </div>

          <div id="workshop-list" class="workshop-list" aria-live="polite">
            <div class="list-loading"><span></span><span></span><span></span><p>Loading workshop ideas…</p></div>
          </div>
          <p id="list-error" class="form-error" role="alert"></p>
          <div class="list-footer">
            <span id="selection-count">0 selected</span>
            <button id="save-rsvps" class="primary-button" type="button">Save <span aria-hidden="true">→</span></button>
          </div>
          <div id="success-message" class="success-message" role="status" hidden>
            <span aria-hidden="true">✓</span>
            <div><strong>RSVPs saved.</strong><br />We’ll see you in the workshop.</div>
          </div>
          <form id="another-idea-form" class="another-idea-form">
            <label for="another-workshop-idea">Submit another idea</label>
            <div class="another-idea-row">
              <input id="another-workshop-idea" name="anotherWorkshopIdea" type="text" minlength="2" maxlength="120" placeholder="Workshop or class idea" required />
              <button class="secondary-button" type="submit">Add idea <span aria-hidden="true">→</span></button>
            </div>
            <p id="another-idea-error" class="form-error" role="alert"></p>
            <p id="another-idea-success" class="another-idea-success" role="status" hidden>Idea added.</p>
          </form>
        </section>
      </section>

      <footer class="workshop-footer">
        <span>Make · Learn · Teach</span>
        <span>NYC</span>
      </footer>
    </main>
    <script src="/scripts/maker-workshops.js" defer></script>
  </body>
</html>
